{
  "name": "logistics-erp",
  "version": "1.0.0",
  "type": "module",
  "description": "LogiBill ERP - Modern Logistics Management, Billing & Invoicing System",
  "main": "server/dist/server.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "prisma generate --schema=server/prisma/schema.prisma && tsc -p server",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "vercel-build": "prisma generate --schema=server/prisma/schema.prisma && tsc -p server && npm --prefix client run build",
    "start": "npm --prefix server start",
    "prisma:generate": "prisma generate --schema=server/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=server/prisma/schema.prisma",
    "prisma:seed": "tsx server/prisma/seed.ts",
    "setup": "npm run prisma:generate && npm run prisma:push && npm run prisma:seed"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.13.8",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.1.2",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4"
  }
}
